# Modèle de configuration pour l'hébergement sur un VPS.
# Copier en « .env » à la racine du dépôt (jamais commité), remplir, puis :
#
#   docker compose -f docker-compose.yml -f docker-compose.vps.yml up -d --build
#
# Voir docs/ENTRA_ID.md, section « Hébergement sur un VPS ».

# Nom de domaine public, sans https:// ni barre finale. Son enregistrement
# DNS (A, et AAAA si IPv6) doit pointer vers l'IP du VPS AVANT le premier
# lancement : Caddy en a besoin pour obtenir le certificat HTTPS.
DOMAINE=smarthub.example.com

# Clé secrète Django : longue, aléatoire, propre à ce serveur. Par exemple :
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Base PostgreSQL (conteneur db). Changer le mot de passe.
DB_NAME=oseordigitalisation
DB_USER=oseor
DB_PASSWORD=

# --- Microsoft Entra ID : bouton « Se connecter avec Microsoft » ---
# Entra > App registrations > SmartHub > Overview.
# Redirect URI à inscrire (type Web) : https://<DOMAINE>/oidc/callback/
# Laisser vide : le bouton reste affiché mais indique que la connexion
# Microsoft n'est pas encore activée.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
