# Modèle de configuration pour l'hébergement sur un VPS.
# Copier en « .env » à la racine du dépôt (jamais commité), remplir, puis :
#
#   docker compose -f docker-compose.yml -f docker-compose.vps.yml up -d --build
#
# Voir README.md, section « Déploiement sur un VPS ».

# Nom de domaine public, sans https:// ni barre finale. Son enregistrement
# DNS (A, et AAAA si IPv6) doit pointer vers l'IP du VPS AVANT le premier
# lancement : Caddy en a besoin pour obtenir le certificat HTTPS.
DOMAINE=smarthub.example.com

# Clé secrète Django : longue, aléatoire, propre à ce serveur. Par exemple :
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Base PostgreSQL (conteneur db). Choisir le mot de passe AVANT le premier
# lancement : il est fixé à la création de la base et ne change plus
# ensuite, même si on le modifie ici.
DB_NAME=oseordigitalisation
DB_USER=oseor
DB_PASSWORD=

# --- Microsoft Entra ID : connexion Microsoft + synchronisation ---
# Entra > App registrations > SmartHub > Overview.
#   - Redirect URI à inscrire (type Web) : https://<DOMAINE>/oidc/callback/
#   - API permissions : Microsoft Graph > Application > User.Read.All,
#     puis « Grant admin consent » (synchronisation de l'annuaire)
# Laisser vide : le bouton Microsoft indique que la connexion n'est pas
# activée, et l'application reste sur le mot de passe.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- E-mails (notifications), facultatif ---
# Laisser vide : les e-mails ne partent pas, ils s'affichent dans les
# journaux du conteneur api. Exemple Office 365 :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=smarthub@oseor.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=smarthub@oseor.com
